@article{eisenachEffectsIntrathecalKetorolac2010,
  title = {Effects of Intrathecal Ketorolac on Human Experimental Pain},
  author = {Eisenach, James C. and Curry, Regina and Tong, Chuanyao and Houle, Timothy T. and Yaksh, Tony L.},
  year = 2010,
  month = may,
  journal = {Anesthesiology},
  volume = {112},
  number = {5},
  pages = {1216--1224},
  issn = {1528-1175},
  doi = {10.1097/ALN.0b013e3181d94d8b},
  abstract = {BACKGROUND: Nonsteroidal antiinflammatory drugs, the most commonly used analgesics, reduce pain not only by inhibiting cyclooxygenase at peripheral sites of inflammation but also by potentially inhibiting cyclooxygenase in the central nervous system, especially the spinal cord. Animal studies suggest that products of cyclooxygenase in the spinal cord do not alter pain responses to acute noxious stimuli but reduce pain and sensitization after peripheral inflammation. We used a spinal injection of small doses of the cyclooxygenase inhibitor ketorolac to survey the role of spinal cyclooxygenase in human experimental pain and hypersensitivity states. METHODS: After regulatory agency approval and informed consent, we examined the effect of 2.0 mg intrathecal ketorolac in 41 healthy volunteers to acute noxious thermal stimuli in normal skin and to mechanical stimuli in skin sensitized by topical capsaicin or ultraviolet burn. We also examined the effect of intravenous ketorolac. RESULTS: Intrathecal ketorolac reduced hypersensitivity when it was induced by a combination of ultraviolet burn plus intermittent heat and, according to one of the two analytical strategies, when it was induced by ultraviolet burn alone. CONCLUSIONS: These data suggest a more limited role for spinal cord cyclooxygenase in human pain states than predicted by studies in animals.},
  langid = {english},
  pmcid = {PMC2924167},
  pmid = {20395821},
  keywords = {Adolescent,Adult,Capsaicin,Female,Hot Temperature,Humans,Injections Spinal,Ketorolac,Male,Middle Aged,Pain,Pain Measurement,Physical Stimulation,Ultraviolet Rays,Young Adult}
}

