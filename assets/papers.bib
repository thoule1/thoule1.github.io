@article{kingBiphasicAlcoholResponse2002,
  title = {Biphasic Alcohol Response Differs in Heavy versus Light Drinkers},
  author = {King, Andrea C. and Houle, Tim and {de Wit}, Harriet and Holdstock, Louis and Schuster, Alyson},
